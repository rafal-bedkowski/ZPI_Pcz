{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "JwtOptions": {
    "Issuer": "WebStore.Web",
    "Audience": "WebStore.Clients",
    "TokenExpirationMinutes": 20
  },
  "Database": {
    "Provider": "Sqlite",
    "SqliteFile": "webstore.db"
  }
}
